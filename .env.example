# Datos del proyecto de Supabase usado para sincronizar (opcional).
# Sin estas variables la app funciona igual, sólo con datos locales.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx
# Client ID de Google (OAuth, tipo "Web application") para el botón de Google dentro de la app.
# Sin esta variable se usa el login de Google por redirección de Supabase.
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
